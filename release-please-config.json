{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "initial-version": "0.2.0",
  "bump-minor-pre-major": false,
  "bump-patch-for-minor-pre-major": false,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "string-lights",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/string-lights-core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/string-lights-react/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/string-lights-react/package.json",
          "jsonpath": "$.dependencies['string-lights']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/string-lights-core'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/string-lights-react'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/string-lights-react'].dependencies['string-lights']"
        }
      ]
    }
  }
}
