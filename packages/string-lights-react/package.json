  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "festival",
    "festival-lights",
    "christmas",
    "christmas-lights",
    "diwali",
