{
  "name": "string-lights-project",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node scripts/unit-tests.mjs",
    "build": "node scripts/build-string-packages.mjs",
    "predev": "npm run build",
    "dev": "node string-preview.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc -p tsconfig.json",
    "test:browser": "playwright test",
    "test:packages": "node scripts/check-packages.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:packages && npm run test:browser",
    "version:auto": "node scripts/version.mjs"
  },
  "workspaces": [
    "packages/string-lights-core",
    "packages/string-lights-react"
  ],
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "release-please": "17.11.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satnamsvirdi/string-lights.git"
  },
  "homepage": "https://github.com/satnamsvirdi/string-lights#readme",
  "bugs": {
    "url": "https://github.com/satnamsvirdi/string-lights/issues"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
